
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acesso direto a arquivos e pastas internos
    RewriteRule ^(app|vendor|writable|tests|system)(/|$) - [F,NC]
    RewriteRule ^(spark|composer\.(json|lock)|phpunit\.xml(\.dist)?|env)$ - [F,NC]

    # Direcionar para a pasta public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
